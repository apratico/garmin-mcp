<?xml version="1.0" encoding="UTF-8"?>
<!--
  stdio transport: stdout carries MCP JSON-RPC messages only, so there is no console appender.
  Everything goes to the file set by logging.file.name; levels come from application.yml.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property name="LOG_FILE" value="${LOG_FILE:-${user.home}/.cache/garmin-mcp/garmin-mcp.log}"/>
    <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>

    <root level="WARN">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
